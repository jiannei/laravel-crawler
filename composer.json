{
    "name": "jiannei\/laravel-crawler",
    "description": "crawler",
    "license": "MIT",
    "authors": [
        {
            "name": "jiannei",
            "email": "longjian.huang@foxmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Jiannei\\LaravelCrawler\\": "src"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Jiannei\\LaravelCrawler\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jiannei\\LaravelCrawler\\Providers\\LaravelServiceProvider"
            ],
            "aliases": {
                "Crawler": "Jiannei\\LaravelCrawler\\Facades\\Crawler"
            }
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "phpunit/phpunit": "^13.4",
        "guzzlehttp/guzzle": "^8.3",
        "laravel/pint": "^1.32"
    },
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "symfony/dom-crawler": "^8.1",
        "php-webdriver/webdriver": "^1.16"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:integration": "vendor/bin/phpunit --group integration",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test"
    }
}
